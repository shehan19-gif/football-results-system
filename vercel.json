{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/api-docs.html"
    },
    {
      "source": "/api/football/v1/results/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/football/v1/results",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/api-docs.html"
    }
  ]
}